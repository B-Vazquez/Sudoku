{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: build Sudoku",
      "command": "/usr/bin/g++",
      "args": [
        "-std=c++17",
        "-g",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "${workspaceFolder}/Sudoku/main.cpp",
        "${workspaceFolder}/Sudoku/Sudoku.cpp",
        "-o",
        "${workspaceFolder}/sudoku-solver"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Build the 16x16 Sudoku solver with g++."
    }
  ]
}